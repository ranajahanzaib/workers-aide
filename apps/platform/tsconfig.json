{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "worker-configuration.d.ts",
    "tests",
    "vitest.config.ts"
  ]
}
